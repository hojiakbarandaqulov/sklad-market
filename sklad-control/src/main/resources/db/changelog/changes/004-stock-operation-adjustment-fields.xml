<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.29.xsd">

    <!-- Eski jurnallardagi noma'lum qiymatlar null qoladi; mavjud yozuvlar o'zgarmaydi. -->
    <changeSet id="004-operation-company" author="sklad">
        <preConditions onFail="MARK_RAN">
            <not><columnExists tableName="stock_operations" columnName="company_id"/></not>
        </preConditions>
        <addColumn tableName="stock_operations">
            <column name="company_id" type="BIGINT"/>
        </addColumn>
        <rollback><dropColumn tableName="stock_operations" columnName="company_id"/></rollback>
    </changeSet>

    <changeSet id="004-operation-idempotency-key" author="sklad">
        <preConditions onFail="MARK_RAN">
            <not><columnExists tableName="stock_operations" columnName="idempotency_key"/></not>
        </preConditions>
        <addColumn tableName="stock_operations">
            <column name="idempotency_key" type="VARCHAR(128)"/>
        </addColumn>
        <rollback><dropColumn tableName="stock_operations" columnName="idempotency_key"/></rollback>
    </changeSet>

    <changeSet id="004-operation-reserved-snapshot" author="sklad">
        <preConditions onFail="MARK_RAN">
            <not><columnExists tableName="stock_operations" columnName="reserved_snapshot"/></not>
        </preConditions>
        <addColumn tableName="stock_operations">
            <column name="reserved_snapshot" type="DECIMAL(19,3)"/>
        </addColumn>
        <rollback><dropColumn tableName="stock_operations" columnName="reserved_snapshot"/></rollback>
    </changeSet>

    <changeSet id="004-operation-company-key-unique" author="sklad">
        <preConditions onFail="MARK_RAN">
            <not>
                <uniqueConstraintExists tableName="stock_operations" constraintName="uk_stock_operations_company_key"/>
            </not>
        </preConditions>
        <addUniqueConstraint tableName="stock_operations" columnNames="company_id,idempotency_key"
                             constraintName="uk_stock_operations_company_key"/>
        <rollback>
            <dropUniqueConstraint tableName="stock_operations" constraintName="uk_stock_operations_company_key"/>
        </rollback>
    </changeSet>
</databaseChangeLog>
