<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.29.xsd">
    <changeSet id="003-reservation-reason" author="sklad">
        <preConditions onFail="MARK_RAN"><not><columnExists tableName="stock_reservations" columnName="reason"/></not></preConditions>
        <addColumn tableName="stock_reservations"><column name="reason" type="VARCHAR(2000)"/></addColumn>
        <rollback><dropColumn tableName="stock_reservations" columnName="reason"/></rollback>
    </changeSet>
    <changeSet id="003-operation-reservation" author="sklad">
        <preConditions onFail="MARK_RAN"><not><columnExists tableName="stock_operations" columnName="reservation_id"/></not></preConditions>
        <addColumn tableName="stock_operations"><column name="reservation_id" type="BIGINT"/></addColumn>
        <createIndex tableName="stock_operations" indexName="idx_stock_operations_reservation"><column name="reservation_id"/></createIndex>
        <rollback>
            <dropIndex tableName="stock_operations" indexName="idx_stock_operations_reservation"/>
            <dropColumn tableName="stock_operations" columnName="reservation_id"/>
        </rollback>
    </changeSet>
    <changeSet id="003-optional-reservation-order" author="sklad">
        <comment>Order-service bo'lmasa ham rezerv yaratish mumkin. Eski ma'lumot o'chirilmaydi.</comment>
        <dropNotNullConstraint tableName="stock_reservations" columnName="order_id" columnDataType="BIGINT"/>
        <!-- Buyurtmasiz rezervlar mavjud bo'lishi mumkin: rollback ham ustunni nullable qoldiradi. -->
        <rollback/>
    </changeSet>
</databaseChangeLog>

