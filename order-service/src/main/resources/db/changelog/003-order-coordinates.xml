<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.29.xsd">
    <changeSet id="003-order-coordinates" author="order-service">
        <addColumn tableName="market_orders">
            <column name="longitude" type="DECIMAL(10,7)"/>
            <column name="latitude" type="DECIMAL(10,7)"/>
        </addColumn>
        <rollback>
            <dropColumn tableName="market_orders" columnName="longitude"/>
            <dropColumn tableName="market_orders" columnName="latitude"/>
        </rollback>
    </changeSet>
</databaseChangeLog>
